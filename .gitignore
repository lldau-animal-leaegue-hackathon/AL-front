# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (실제 값이 들어있는 파일은 절대 커밋하지 않습니다)
.env
.env.*
# 단, 키 목록만 적어둔 템플릿은 커밋합니다
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.idea/
*.swp

# claude code — 개인 설정/로컬 산출물은 공유하지 않는다 (.claude/settings.json 과 skills 는 커밋)
.claude/settings.local.json
.claude/claude-code-chat-images/
.claude/*.lock
