# 이 파일을 복사해서 .env.local 을 만들고 실제 값을 채워 넣으세요.
#   Windows(PowerShell): Copy-Item .env.example .env.local
#   macOS / Linux:       cp .env.example .env.local
#
# .env.local 은 .gitignore 에 걸려 있어 커밋되지 않습니다. 실제 키를 여기(.env.example)에 적지 마세요.
#
# 규칙: NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저 번들에 그대로 노출됩니다.
#       비밀 키에는 절대 NEXT_PUBLIC_ 을 붙이지 마세요.

# --- 서버 전용 (브라우저에 노출되지 않음) ---

# next.config.ts 의 rewrites 가 /api/* 를 이 주소로 프록시합니다.
# 비워두면 프록시를 사용하지 않습니다.
BACKEND_ORIGIN=http://localhost:8080

# --- 브라우저에 노출됨 ---

# 클라이언트에서 직접 호출할 API 베이스 URL
NEXT_PUBLIC_API_BASE_URL=/api
